            <row id="Top">78</row>
            <row id="Width">377</row>
            <row id="Height">29</row>
            <row id="Caption" changed="20200208T021148Z" si="15173">
              <value>First, you have to get an account key.</value>
              <lang id="fi" rw="0" ex="1" time="20221107T005359Z" fuzzy="99.5">Ensin sinun on hankittava tilin avain.</lang>
              <lang id="cs" rw="0" ex="1" time="20260511T175239Z">Nejprve musíte získat klíč k účtu.</lang>
            </row>
          </item>
