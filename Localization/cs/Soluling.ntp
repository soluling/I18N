          <item name="LanguagesSheet" type="TTabSheet">
            <row id="Caption" si="28144">
              <value>Languages</value>
              <lang id="fi" rw="0" ex="1" time="20230316T224736Z" fuzzy="99">Kielet</lang>
              <lang id="cs" rw="0" ex="1" time="20260511T175520Z">Jazyky</lang>
