          <row id="Caption" changed="20200208T021148Z" si="1301">
            <value> When writing a localized item that does not have a translation </value>
            <lang id="fi" rw="0" ex="1" time="20230319T173402Z" fuzzy="99.5"> Kun kirjoitat lokalisoitua kohdetta, jolla ei ole käännöstä </lang>
