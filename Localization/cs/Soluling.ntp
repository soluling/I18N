          <lang id="fi" rw="0" ex="1" time="20251110T041922Z">Ottelu rivin lopussa</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175441Z">Shoda na konci řádku</lang>
        </row>
        <row id="SMatchAnyOneCharacterFromTheSet" si="19772">
