              <row id="Top">24</row>
              <row id="Width">304</row>
              <row id="Height">13</row>
              <row id="Caption" si="28163">
                <value>Setup can launch Soluling. Choose the options you want below.</value>
                <lang id="fi" rw="0" ex="1" time="20251109T142935Z" fuzzy="99.5">Asennusohjelma voi käynnistää Solulingin. Valitse haluamasi vaihtoehdot alta.</lang>
                <lang id="cs" rw="0" ex="1" time="20260511T182954Z">Instalace může spustit aplikaci Soluling. Vyberte níže požadované možnosti.</lang>
              </row>
            </item>
            <item name="CompleteLabel3" type="TLabel">
              <row id="Left">0</row>
              <row id="Top">224</row>
              <row id="Width">145</row>
              <row id="Height">13</row>
              <row id="Caption" si="28164">
                <value>Click Finish to complete Setup.</value>
                <lang id="fi" rw="0" ex="1" time="20251109T142936Z" fuzzy="99.5">Napsauta Valmis viimeistelläksesi asennuksen.</lang>
                <lang id="cs" rw="0" ex="1" time="20260511T185636Z">Klikněte na Dokončit pro dokončení instalace.</lang>
              </row>
            </item>
            <item name="CompleteLabel" type="TLabel">
              <row id="Left">0</row>
              <row id="Top">0</row>
              <row id="Width">283</row>
              <row id="Height">13</row>
              <row id="Caption" si="28165">
                <value>The setup has finished installing Soluling on your computer.</value>
                <lang id="fi" rw="0" ex="1" time="20251109T142938Z" fuzzy="99.5">Asennusohjelma on asentanut Solulingin tietokoneellesi.</lang>
                <lang id="cs" rw="0" ex="1" time="20260511T182954Z">Instalace aplikace Soluling do vašeho počítače byla dokončena.</lang>
              </row>
            </item>
