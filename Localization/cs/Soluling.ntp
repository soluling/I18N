      <node class="TWindowsStringNode" name="RegularExpressionFra" created="20200102T060958Z">
        <row id="SPreferZero" si="19745">
          <value>Prefer zero</value>
          <lang id="fi" rw="0" ex="1" time="20251110T041923Z">Mieluummin nolla</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175441Z">Preferovat nulu</lang>
        </row>
        <row id="SAlternation" si="19746">
          <value>Alternation</value>
          <lang id="fi" rw="0" ex="1" time="20251110T041922Z">Vuorottelu</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175441Z">Alternativní</lang>
        </row>
        <row id="SMatchZeroOrOneTimes" changed="20200208T021148Z" si="19747">
          <value>Match zero or one time</value>
          <lang id="fi" rw="0" ex="1" time="20251110T041922Z">Vastaa nollaa tai yhtä kertaa</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175441Z">Shoduje se s nulou nebo jednou</lang>
        </row>
        <row id="SMatchExactlyNTimes" si="19748">
          <value>Match exactly n times</value>
          <lang id="fi" rw="0" ex="1" time="20251110T041922Z">Täsmää täsmälleen n kertaa</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175441Z">Shodují se přesně nkrát</lang>
        </row>
        <row id="SMatchAtLeastNTimes" si="19749">
          <value>Match at least n times</value>
          <lang id="fi" rw="0" ex="1" time="20251110T041922Z">Täsmää vähintään n kertaa</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175441Z">Shoduje se alespoň n- krát</lang>
        </row>
        <row id="SMatchAtLeatNTimesButNoMore" si="19750">
          <value>Match at least n times, but no more than required for an overall pattern match</value>
          <lang id="fi" rw="0" ex="1" time="20251110T041922Z">Täsmää vähintään n kertaa, mutta enintään kuin kokonaiskuvion täsmäämiseen vaaditaan</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175441Z">Porovnat alespoň nkrát, ale ne více, než je nutné pro celkové porovnání vzoru</lang>
        </row>
        <row id="SMatchBetweenNAndMTimesAsMany" si="19751">
          <value>Match between n and m times. Match as many times as possible, but not more than m.</value>
          <lang id="fi" rw="0" ex="1" time="20251110T041922Z">Etsi täsmäävä määrä n ja m kertaa. Etsi täsmäävä määrä kertoja, mutta enintään m.</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175441Z">Porovnat mezi n a mkrát. Porovnejte tolikrát, kolikrát je možné, ale ne více než mkrát.</lang>
        </row>
        <row id="SMatchBetweenNAndMTimesAsFew" si="19752">
          <value>Match between n and m times. Match as few times as possible, but not less than n.</value>
          <lang id="fi" rw="0" ex="1" time="20251110T041922Z">Etsi täsmäävä määrä n ja m kertaa. Löydä täsmäävä määrä niin vähän kuin mahdollista, mutta vähintään n kertaa.</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175441Z">Porovnat mezi n a mkrát. Porovnejte co nejméněkrát, ale ne méně než nkrát.</lang>
        </row>
        <row id="SOther" si="19753">
          <value>Other</value>
          <lang id="fi" rw="0" ex="1" time="20230319T172547Z">Muu</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175441Z">Další</lang>
        </row>
        <row id="SHeaderNumber" si="19754">
          <value>Header number (1.)</value>
          <lang id="fi" rw="0" ex="1" time="20251110T041922Z">Ylätunnisteen numero (1.)</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175441Z">Číslo hlavičky (1.)</lang>
        </row>
        <row id="SSingleLineComment" si="19755">
          <value>Single line comment</value>
          <lang id="fi" rw="0" ex="1" time="20251110T041922Z">Yhden rivin kommentti</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175441Z">Jednořádkový komentář</lang>
        </row>
        <row id="SMatchWhiteSpace" si="19761">
          <value>Match a white space character</value>
          <lang id="fi" rw="0" ex="1" time="20251110T041923Z">Vastaa välilyöntiä</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175441Z">Shoda se znakem prázdné mezery</lang>
        </row>
        <row id="SMatchNonWhiteSpace" si="19762">
          <value>Match a non-white space character</value>
          <lang id="fi" rw="0" ex="1" time="20251110T041922Z">Vastaa ei-tyhjää välilyöntiä</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175441Z">Porovnat znak, který není mezerou</lang>
        </row>
        <row id="SMetacharacters" si="19763">
          <value>More metacharacters</value>
          <lang id="fi" rw="0" ex="1" time="20251110T041922Z">Lisää metahahmoja</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175441Z">Další metaznaky</lang>
        </row>
        <row id="SMatchIfWordBoundary" si="19764">
          <value>Match if the current position is a word boundary</value>
          <lang id="fi" rw="0" ex="1" time="20251110T041949Z">Vastaa, jos nykyinen sijainti on sanaraja</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175441Z">Shoda pokud je aktuální pozice hranicí slova</lang>
        </row>
        <row id="SMatchIfNotWordBoundary" si="19765">
          <value>Match if the current position is not a word boundary</value>
          <lang id="fi" rw="0" ex="1" time="20251110T041957Z">Vastaa, jos nykyinen sijainti ei ole sanaraja</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175441Z">Shoda pokud aktuální pozice není hranicí slova</lang>
        </row>
        <row id="SMatchAnyCharacterThatIsNotDecimalDigit" si="19766">
          <value>Match any character that is not a decimal digit</value>
          <lang id="fi" rw="0" ex="1" time="20251110T041922Z">Vastaa mitä tahansa merkkiä, joka ei ole desimaaliluku</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175441Z">Shoda s libovolným znakem který není desetinnou číslicí</lang>
        </row>
        <row id="SMatchEndOfInputButBeforeFinlanLine" si="19767">
          <value>Match if the current position is at the end of input, but before the final line terminator, if one exists</value>
          <lang id="fi" rw="0" ex="1" time="20251110T042003Z">Vastaa, jos nykyinen sijainti on syötteen lopussa, mutta ennen viimeisen rivin päättäjämerkkiä, jos sellainen on olemassa</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175441Z">Shoda, pokud je aktuální pozice na konci vstupu, ale před koncovým znakem řádku, pokud existuje</lang>
        </row>
        <row id="SMatchEndOfInput" si="19768">
          <value>Match if the current position is at the end of input</value>
          <lang id="fi" rw="0" ex="1" time="20251110T042009Z">Vastaa, jos nykyinen sijainti on syötteen lopussa</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175441Z">Shoda pokud je aktuální pozice na konci vstupu</lang>
        </row>
        <row id="SMatchCharacterWithHexValue" si="19769">
          <value>Match the character with the hex value hhhh</value>
          <lang id="fi" rw="0" ex="1" time="20251110T041922Z">Yhdistä merkki heksadesimaaliarvoon hhhh</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175441Z">Odpovídá znaku s hexadecimální hodnotou hhhhh</lang>
        </row>
        <row id="SMatchAtBeginningOfLine" si="19770">
          <value>Match at the beginning of a line</value>
          <lang id="fi" rw="0" ex="1" time="20251110T041922Z">Ottelu rivin alussa</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175441Z">Shoda na začátku řádku</lang>
        </row>
        <row id="SMatchAtEndOfLine" si="19771">
