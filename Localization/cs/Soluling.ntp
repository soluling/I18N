          <row id="Caption" changed="20210110T150954Z" si="15198">
            <value> If you don't have a serial number, select your role, and then choose an action </value>
            <lang id="fi" rw="0" ex="1" time="20230319T171039Z" fuzzy="99.5"> Jos sinulla ei ole sarjanumeroa, valitse roolisi ja valitse sitten toiminto </lang>
            <lang id="cs" rw="0" ex="1" time="20260511T175239Z"> Pokud nemáte sériové číslo, vyberte svou roli a poté zvolte akci </lang>
          </row>
          <row id="Items.Strings[0]" si="15199">
