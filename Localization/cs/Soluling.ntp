                <prev>Select the &amp;default language.</prev>
                <lang id="fi" rw="0" ex="1" time="20260515T013800Z">Valitse &amp;oletuskieli:</lang>
                <lang id="cs" rw="0" ex="1" time="20260515T013832Z">&amp;Vyberte výchozí jazyk:</lang>
              </row>
            </item>
