        <item name="BasicGroup" type="TGroupBox" created="20210110T150954Z">
          <row id="Left">0</row>
          <row id="Top">280</row>
          <row id="Width">529</row>
          <row id="Height">65</row>
          <row id="Caption" si="22836">
            <value> Install the Basic Translator edition </value>
            <lang id="fi" rw="0" ex="1" time="20230319T171052Z" fuzzy="99.5"> Asenna Basic Translator -versio </lang>
            <lang id="cs" rw="0" ex="1" time="20260511T175239Z"> Nainstalovat edici Basic Translator </lang>
          </row>
          <item name="Label1" type="TLabel" autosize="0">
            <row id="Left">96</row>
            <row id="Top">16</row>
            <row id="Width">313</row>
            <row id="Height">41</row>
            <row id="Caption" si="22837">
              <value>Basic Translator edition is free, but you can only translate existing projects. Also, it lacks many features, such as translation memory, machine translation, terminology, spell checker, import/export.</value>
              <lang id="fi" rw="0" ex="1" time="20230319T171055Z" fuzzy="99.5">Basic Translator -versio on ilmainen, mutta voit kääntää vain olemassa olevia projekteja. Lisäksi siitä puuttuu monia ominaisuuksia, kuten käännösmuisti, konekäännös, terminologia, oikeinkirjoituksen tarkistus, tuonti / vienti.</lang>
              <lang id="cs" rw="0" ex="1" time="20260511T175240Z">Edice Basic Translator je zdarma, ale můžete překládat pouze existující projekty. Také postrádá mnoho funkcí, jako je překladová paměť, strojový překlad, terminologie, kontrola pravopisu, import/export.</lang>
            </row>
          </item>
          <item name="BasicImage" type="TNtResourceImage">
            <row id="Left">32</row>
            <row id="Top">16</row>
            <row id="Width">32</row>
            <row id="Height">32</row>
          </item>
          <item name="UseBasicButton" type="TButton">
            <row id="Left">408</row>
            <row id="Top">16</row>
            <row id="Width">113</row>
            <row id="Height">25</row>
            <row id="Caption" si="22839">
              <value>&amp;Use Basic edition</value>
              <lang id="fi" rw="0" ex="1" time="20251109T061200Z">&amp;Käytä Basic-versiota</lang>
              <lang id="cs" rw="0" ex="1" time="20260511T175240Z">&amp;Použít základní edici</lang>
            </row>
          </item>
        </item>
