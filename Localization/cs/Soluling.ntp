      <node class="TWindowsStringNode" name="GridFindDlg" created="20200102T060958Z">
        <row id="SReplaceCanNotFind" changed="20250106T095608Z" si="17663" created="20250106T095608Z" codep="1">
          <value>%0:s cannot find any text to replace. Check if your search formatting and criteria are defined correctly. If you are sure that matching text exists, it may be read only. %0:s cannot replace read only text.</value>
          <lang id="fi" rw="0" ex="1" time="20251106T053120Z" fuzzy="99.5">%0:s ei löydä korvattavaa tekstiä. Tarkista, onko hakumuotoilu ja -ehdot määritetty oikein. Jos olet varma, että vastaavaa tekstiä on olemassa, se saattaa olla vain luettavissa. %0:s ei voi korvata vain luettavaa tekstiä.</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175342Z">%0:s nemůže najít žádný text k nahrazení. Zkontrolujte, zda jsou formátování a kritéria vyhledávání definovány správně. Pokud jste si jisti, že odpovídající text existuje, může být pouze pro čtení. %0:s nemůže nahradit text pouze pro čtení.</lang>
        </row>
        <row id="SReplaceCompleted" changed="20250106T095608Z" si="17694" created="20250106T095608Z" codep="1">
          <value>%s has completed its search and has made %d replacements.</value>
          <lang id="fi" rw="0" ex="1" time="20251106T053118Z" fuzzy="99.5">%s on suorittanut hakunsa ja tehnyt %d korvausta.</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175342Z">%s dokončilo vyhledávání a provedlo %d náhrad.</lang>
        </row>
      </node>
