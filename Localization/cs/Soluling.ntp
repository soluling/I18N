      <node class="TWindowsStringNode" name="MachineTranslator" created="20200102T060958Z">
        <row id="SEngineMessage" changed="20250106T095608Z" si="18371" created="20250106T095608Z" codep="1">
          <value>Could not translate "%0:s". %1:s reported an error message: %2:s</value>
          <lang id="fi" rw="0" ex="1" time="20251107T042822Z" fuzzy="99.5">Kohtaa "%0:s" ei voitu kääntää. %1:s raportoi virheilmoituksen: %2:s</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175401Z">Nelze přeložit „%0:s“. %1:s nahlásilo chybovou zprávu: %2:s</lang>
        </row>
        <row id="STooManyErrorsText" si="18372">
          <value>Too many errors. Aborting translation.</value>
          <lang id="fi" rw="0" ex="1" time="20251107T042823Z" fuzzy="99.5">Liikaa virheitä. Käännös keskeytetään.</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175401Z">Příliš mnoho chyb. Překlad se ruší.</lang>
        </row>
        <row id="SConnectionErrorText" changed="20250106T095608Z" si="23789" created="20250106T095608Z" codep="1">
