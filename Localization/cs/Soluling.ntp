        </row>
        <row id="SNetUiLocaleCaption" si="18932">
          <value>.NET User Interface Culture</value>
          <lang id="fi" rw="0" ex="1" time="20251106T155506Z" fuzzy="99.5">.NET-käyttöliittymäkulttuuri</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175347Z">Kultura uživatelského rozhraní .NET</lang>
