      <node class="TDelphiFormNode" name="TIMPORTDROPACTIONFRAME" type="TImportDropActionFrame" resname="TIMPORTDROPACTIONFRAME" created="20200102T035339Z" objectname="ImportDropActionFrame" parent="TStandardFrame" flags="[ffInherited]">
        <row id="Height">97</row>
        <item name="ActionGroup" type="TRadioGroup">
          <row id="Left">0</row>
          <row id="Top">0</row>
          <row id="Width">505</row>
          <row id="Height">97</row>
          <row id="Caption" si="15145">
            <value> Action that happens after a project import file drops to the open workspace </value>
            <lang id="fi" rw="0" ex="1" time="20230318T152108Z" fuzzy="99.5"> Toiminto, joka tapahtuu, kun projektin tuontitiedosto pudotetaan avoimeen työtilaan </lang>
            <lang id="cs" rw="0" ex="1" time="20260511T175237Z"> Akce, která se provede po přetažení souboru pro import projektu do otevřeného pracovního prostoru </lang>
          </row>
          <row id="Items.Strings[0]" si="15146">
            <value>&amp;Add a dropped file into the current project</value>
            <lang id="fi" rw="0" ex="1" time="20230318T152059Z" fuzzy="99.5">&amp;Lisää pudotettu tiedosto nykyiseen projektiin</lang>
            <lang id="cs" rw="0" ex="1" time="20260511T175237Z">&amp;Přidat přetažený soubor do aktuálního projektu</lang>
          </row>
          <row id="Items.Strings[1]" si="15147">
            <value>&amp;Create a new project for the dropped file</value>
            <lang id="fi" rw="0" ex="1" time="20230318T152117Z" fuzzy="99.5">&amp;Luo uusi projekti pudotetulle tiedostolle</lang>
            <lang id="cs" rw="0" ex="1" time="20260511T175237Z">&amp;Vytvořit nový projekt pro přetažený soubor</lang>
          </row>
          <row id="Items.Strings[2]" si="15148">
            <value>&amp;Import translations from the dropped file into the active language</value>
            <lang id="fi" rw="0" ex="1" time="20230318T152122Z" fuzzy="99.5">&amp;Tuo käännökset pudotetusta tiedostosta aktiiviseen kieleen</lang>
            <lang id="cs" rw="0" ex="1" time="20260511T175237Z">&amp;Importovat překlady z přetaženého souboru do aktivního jazyka</lang>
          </row>
          <row id="Items.Strings[3]" si="15149">
            <value>I&amp;mport translations from the dropped file into all languages</value>
            <lang id="fi" rw="0" ex="1" time="20230318T152131Z" fuzzy="99.5">&amp;Tuon käännökset pudotusta tiedostosta kaikille kielille</lang>
            <lang id="cs" rw="0" ex="1" time="20260511T175237Z">I&amp;mportovat překlady z přetaženého souboru do všech jazyků</lang>
          </row>
        </item>
        <data>
          VFBGMPEWVEltcG9ydERyb3BBY3Rpb25GcmFtZRVJbXBvcnREcm9wQWN0aW9uRnJhbWUGSGVpZ2h0AmEORXhwbGljaXRIZWlnaHQC
