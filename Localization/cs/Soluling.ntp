      <node class="TDelphiFormNode" name="TASSEMBLYSIGNINGFRAME" type="TAssemblySigningFrame" resname="TASSEMBLYSIGNINGFRAME" objectname="AssemblySigningFrame" parent="TSourceFrame" flags="[ffInherited]">
        <item name="Label1" type="TLabel">
          <row id="Left">0</row>
          <row id="Top">0</row>
          <row id="Width" changed="20200208T021148Z">498</row>
          <row id="Height">15</row>
          <row id="Caption" changed="20200208T021148Z" si="131">
            <value>The original assembly is a signed assembly. Localized files should be signed with the same key.</value>
            <lang id="fi" rw="0" ex="1" time="20221108T183316Z" fuzzy="99.5">Alkuperäinen kokoonpano on allekirjoitettu kokoonpano. Lokalisoidut tiedostot tulee allekirjoittaa samalla avaimella.</lang>
            <lang id="cs" rw="0" ex="1" time="20260511T175222Z">Původní sestavení je podepsané. Lokalizované soubory by měly být podepsány stejným klíčem.</lang>
          </row>
        </item>
