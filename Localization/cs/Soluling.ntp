          <row id="Caption" si="15748">
            <value> Add translations to the translation memory </value>
            <lang id="fi" rw="0" ex="1" time="20230404T232408Z" fuzzy="99.5"> Käännösten lisääminen käännösmuistiin </lang>
            <lang id="cs" rw="0" ex="1" time="20260511T175302Z"> Přidat překlady do překladové paměti </lang>
          </row>
          <row id="Items.Strings[0]" si="15749">
            <value>Eac&amp;h time the status of a row exceeds or equals to the status specified below</value>
            <lang id="fi" rw="0" ex="1" time="20230404T232423Z" fuzzy="99.5">Aina kun rivin tila ylittää tai on y&amp;htä suuri kuin alla määritetty tila</lang>
            <lang id="cs" rw="0" ex="1" time="20260511T175302Z">&amp;Pokaždé, když stav řádku překročí nebo se rovná stavu uvedenému níže</lang>
          </row>
          <row id="Items.Strings[1]" si="15750">
            <value>When &amp;clicking Add to Translation Memory button in Project ribbon</value>
            <lang id="fi" rw="0" ex="1" time="20230404T232437Z" fuzzy="99.5">Kun &amp;osoitat Lisää käännösmuistiin -painiketta projektinauhassa</lang>
            <lang id="cs" rw="0" ex="1" time="20260511T175302Z">Při &amp;kliknutí na tlačítko Přidat do překladové paměti na pásu karet Projekt</lang>
          </row>
          <row id="Items.Strings[2]" si="15751">
            <value>Prompted when &amp;saving the project</value>
            <lang id="fi" rw="0" ex="1" time="20230404T232446Z" fuzzy="99.5">Kehotetaan projektia &amp;tallennettaessa</lang>
            <lang id="cs" rw="0" ex="1" time="20260511T175302Z">&amp;Zobrazeno při ukládání projektu</lang>
          </row>
          <row id="Items.Strings[3]" si="15752">
            <value>&amp;Every time when saving the project</value>
            <lang id="fi" rw="0" ex="1" time="20230404T232450Z" fuzzy="99.5">&amp;Aina projektia tallennettaessa</lang>
            <lang id="cs" rw="0" ex="1" time="20260511T175302Z">&amp;Při každém uložení projektu</lang>
          </row>
        </item>
