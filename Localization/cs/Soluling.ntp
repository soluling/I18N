      <node class="TWindowsStringNode" name="MachineTranslatorInfoFra" created="20200102T060958Z">
        <row id="SUseMachineTranslator" changed="20250106T095608Z" si="17625" created="20250106T095608Z" codep="1">
          <value>%s machine translator is ready to be used. Start translating strings automatically.</value>
          <lang id="fi" rw="0" ex="1" time="20251107T042941Z" fuzzy="99.5">Konekäännösohjelma %s on käyttövalmis. Aloita merkkijonojen kääntäminen automaattisesti.</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175402Z">strojový překladatel %s je připraven k použití. Spusťte automatický překlad řetězců.</lang>
        </row>
        <row id="SAddMachineTranslator" changed="20250106T095608Z" si="17626" created="20250106T095608Z" codep="1">
          <value>You can use %s machine translator and start translating strings automatically.</value>
          <lang id="fi" rw="0" ex="1" time="20251107T042942Z" fuzzy="99.5">Voit käyttää %s-konekääntäjää ja aloittaa merkkijonojen kääntämisen automaattisesti.</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175402Z">Můžete použít strojový překladač %s a začít překládat řetězce automaticky.</lang>
        </row>
      </node>
      <node class="TWindowsStringNode" name="MachineTranslatorsFra" created="20200102T060958Z">
        <row id="SSelect" si="16854">
          <value>Select by features...</value>
          <lang id="fi" rw="0" ex="1" time="20251107T042951Z" fuzzy="99.5">Valitse ominaisuuksien mukaan...</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175402Z">Vyberte podle funkcí...</lang>
        </row>
