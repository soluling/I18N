      <node class="TDelphiFormNode" name="TDATABASEROWCONFIGURATIONFRAME" type="TDatabaseRowConfigurationFrame" resname="TDATABASEROWCONFIGURATIONFRAME" created="20240504T141930Z" objectname="DatabaseRowConfigurationFrame" parent="TConfigurationFrame" flags="[ffInherited]">
        <item name="AddGroup" type="TRadioGroup">
          <row id="Left">0</row>
          <row id="Top">104</row>
          <row id="Width">585</row>
          <row id="Height">81</row>
          <row id="Caption" si="24513">
            <value> Add localized rows  </value>
            <lang id="fi" rw="0" ex="1" time="20251104T044902Z" fuzzy="99.5"> Lisää lokalisoituja rivejä  </lang>
            <lang id="cs" rw="0" ex="1" time="20260511T175226Z"> Přidat lokalizované řádky  </lang>
          </row>
          <row id="Items.Strings[0]" si="24514">
            <value>&amp;Always</value>
            <lang id="fi" rw="0" ex="1" time="20230319T173344Z" fuzzy="99.5">&amp;Aina</lang>
            <lang id="cs" rw="0" ex="1" time="20260511T175226Z">&amp;Vždy</lang>
          </row>
          <row id="Items.Strings[1]" si="24515">
            <value>&amp;If the row has at least one translation</value>
            <lang id="fi" rw="0" ex="1" time="20251104T044905Z" fuzzy="99.5">&amp;Jos rivillä on vähintään yksi käännös</lang>
            <lang id="cs" rw="0" ex="1" time="20260511T175226Z">&amp;Pokud řádek obsahuje alespoň jeden překlad</lang>
          </row>
          <row id="Items.Strings[2]" si="24516">
            <value>&amp;Only if the row has all translations completed</value>
            <lang id="fi" rw="0" ex="1" time="20251104T044908Z" fuzzy="99.5">&amp;Vain jos rivillä on kaikki käännökset valmiina</lang>
            <lang id="cs" rw="0" ex="1" time="20260511T175226Z">&amp;Pouze pokud jsou u řádku dokončeny všechny překlady</lang>
          </row>
        </item>
        <item name="ExistingIncompleteRowGroup" type="TRadioGroup" created="20250422T110952Z">
          <row id="Left">0</row>
          <row id="Top">0</row>
          <row id="Width">585</row>
          <row id="Height">97</row>
          <row id="Caption" si="26081">
            <value> When updating an existing localized field that does not have a translation </value>
            <lang id="fi" rw="0" ex="1" time="20251104T044910Z" fuzzy="99.5"> Kun päivitetään olemassa olevaa lokalisoitua kenttää, jolla ei ole käännöstä </lang>
            <lang id="cs" rw="0" ex="1" time="20260511T175226Z"> Při aktualizaci existujícího lokalizovaného pole, které nemá překlad </lang>
          </row>
          <row id="Items.Strings[0]" si="26082">
            <value>&amp;Use original value</value>
            <lang id="fi" rw="0" ex="1" time="20230319T173405Z" fuzzy="99.5">&amp;Käytä alkuperäistä arvoa</lang>
            <lang id="cs" rw="0" ex="1" time="20260511T175226Z">&amp;Použít původní hodnotu</lang>
          </row>
          <row id="Items.Strings[1]" si="26083">
            <value>Use e&amp;mpty value</value>
            <lang id="fi" rw="0" ex="1" time="20230319T173426Z" fuzzy="99.5">&amp;Käytä tyhjää arvoa</lang>
            <lang id="cs" rw="0" ex="1" time="20260511T175226Z">&amp;Použít prázdnou hodnotu</lang>
          </row>
          <row id="Items.Strings[2]" si="26084">
            <value>Use &amp;null value</value>
            <lang id="fi" rw="0" ex="1" time="20230319T173412Z" fuzzy="99.5">Käytä &amp;nolla-arvoa</lang>
            <lang id="cs" rw="0" ex="1" time="20260511T175226Z">Použít &amp;null hodnotu</lang>
          </row>
          <row id="Items.Strings[3]" si="26085">
            <value>&amp;Do not change item</value>
            <lang id="fi" rw="0" ex="1" time="20251104T044913Z" fuzzy="99.5">&amp;Älä muuta kohdetta</lang>
            <lang id="cs" rw="0" ex="1" time="20260511T175226Z">&amp;Nezměnit položku</lang>
          </row>
        </item>
