          <lang id="fi" rw="0" ex="1" time="20251109T153113Z" fuzzy="99.5">Asennetaan koontiautomaatiotiedostoja...</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T182904Z">Instalace souborů pro automatizaci sestavení...</lang>
        </row>
