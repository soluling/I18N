        </row>
        <row id="SComplete" si="17787">
          <value>Complete</value>
          <lang id="fi" rw="0" ex="1" time="20251115T211932Z">Valmis</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175500Z">Kompletní</lang>
        </row>
        <row id="SUseReduced" si="17788">
          <value>Use reduced matching</value>
          <lang id="fi" rw="0" ex="1" time="20251111T154722Z" fuzzy="100">Käytä pienennettyä hakua</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175500Z">Použít redukované porovnávání</lang>
        </row>
        <row id="SUseBidirectional" si="17789">
          <value>Use bidirectional search</value>
          <lang id="fi" rw="0" ex="1" time="20251111T154723Z" fuzzy="100">Käytä kaksisuuntaista hakua</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175500Z">Použijte směrové vyhledávání</lang>
        </row>
        <row id="SCountryNeutral" si="17790">
          <value>Use country neutral translations when translating a sub language</value>
          <lang id="fi" rw="0" ex="1" time="20251111T154724Z" fuzzy="99.5">Käytä maaneutraaleja käännöksiä, kun käännät toista kieltä</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175500Z">Při překladu dílčího jazyka používejte překlady neutrální pro danou zemi</lang>
        </row>
        <row id="SCountrySpecific" si="17759">
          <value>Use country specific translations when translating the main language</value>
          <lang id="fi" rw="0" ex="1" time="20251111T154725Z" fuzzy="100">Käytä maa- ja tiettyjä käännöksiä pääkieltä käännettäessä</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175500Z">Při překladu hlavního jazyka použijte překlady specifické pro danou zemi</lang>
        </row>
        <row id="SDifferentCountry" si="17760">
          <value>Use translations of the same language but different country</value>
          <lang id="fi" rw="0" ex="1" time="20251111T154726Z" fuzzy="99.5">Käytä saman kielen, mutta eri maan käännöksiä</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175500Z">Používejte překlady stejného jazyka ale jiné země</lang>
        </row>
      </node>
