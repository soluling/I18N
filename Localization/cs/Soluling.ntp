      <node class="TWindowsStringNode" name="NetSignature" created="20220321T230915Z">
        <row id="SKeyShouldBeUsed" changed="20250106T095608Z" si="23854" created="20250106T095608Z" codep="1">
          <value>"%0:s" is a signed assembly. You should specify a key. "%1:s" delay signed with a temporal key. You can not deploy the file.</value>
          <lang id="fi" rw="0" ex="1" time="20251105T144933Z" fuzzy="99.5">"%0:s" on allekirjoitettu kokoonpano. Sinun tulee määrittää avain. "%1:s" viive on allekirjoitettu ajallisella avaimella. Et voi ottaa tiedostoa käyttöön.</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175413Z">„%0:s“ je podepsaná sestava. Měli byste zadat klíč. „%1:s“ je podepsáno dočasným klíčem. Soubor nelze nasadit.</lang>
        </row>
      </node>
      <node class="TWindowsStringNode" name="NetSignatureFra" created="20220321T230915Z">
        <row id="SAllEntriesRemoved" si="23852">
          <value>All entries successfully removed.</value>
          <lang id="fi" rw="0" ex="1" time="20251108T130053Z" fuzzy="99.5">Kaikki merkinnät poistettu onnistuneesti.</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175413Z">Všechny položky byly úspěšně odstraněny.</lang>
        </row>
        <row id="SCouldNotRemove" changed="20250106T095608Z" si="23853" created="20250106T095608Z" codep="1">
          <value>Could not remove entries: %d</value>
          <lang id="fi" rw="0" ex="1" time="20251108T125837Z">Merkintöjä ei voitu poistaa: %d</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175413Z">Nelze odstranit položky: %d</lang>
        </row>
        <row id="SDelayStrongName" si="23844">
          <value>Delay sign localized assemblies using a temporal key</value>
          <lang id="fi" rw="0" ex="1" time="20251108T130041Z" fuzzy="99.5">Viivästettyjen lokalisoitujen kokoonpanojen allekirjoittaminen ajallisen avaimen avulla</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175413Z">Opožděné podepsání lokalizovaných sestav pomocí časového klíče</lang>
