        <item name="MethodGroup" type="TRadioGroup">
          <row id="Left">0</row>
          <row id="Top" changed="20210110T151349Z">1</row>
          <row id="Width">585</row>
          <row id="Height">73</row>
          <row id="Caption" si="14859">
            <value> Localization Method </value>
            <lang id="fi" rw="0" ex="1" time="20221108T135110Z" fuzzy="99.5"> Lokalisointimenetelmä </lang>
            <lang id="cs" rw="0" ex="1" time="20260511T175222Z"> Metoda lokalizace </lang>
          </row>
          <row id="Items.Strings[0]" si="22810" created="20210110T150954Z">
            <value>Scan s&amp;ource code to extract strings from localizers but do not create the original .resx files</value>
            <lang id="fi" rw="0" ex="1" time="20241012T091546Z">Skannaa lähdek&amp;oodi ja eristä merkkijonoja localizer-funktiosta, mutta älä luo alkuperäisiä .resx-tiedostoja</lang>
            <lang id="cs" rw="0" ex="1" time="20260511T175222Z">Prohledat s&amp;zdrojový kód, extrahovat řetězce z lokalizátorů, ale nevytvářet původní soubory .resx</lang>
          </row>
          <row id="Items.Strings[1]" si="22811" created="20210110T150954Z">
            <value>Scan source code to extract strings from localizers &amp;and create the original .resx files</value>
            <lang id="fi" rw="0" ex="1" time="20241012T092051Z">Sk&amp;annaa lähdekoodi ja eristä merkkijonoja localizer-funktiosta ja luo alkuperäiset .resx-tiedostot</lang>
            <lang id="cs" rw="0" ex="1" time="20260511T175222Z">Prohledat zdrojový kód, extrahovat řetězce z lokalizátorů &amp;a vytvořit původní soubory .resx</lang>
          </row>
          <row id="Items.Strings[2]" si="14862">
            <value>Do not scan but scan only the &amp;existing resource files</value>
            <lang id="fi" rw="0" ex="1" time="20221108T143211Z" fuzzy="99.5">Älä skannaa, vaan skannaa vain &amp;olemassa olevat resurssitiedostot</lang>
            <lang id="cs" rw="0" ex="1" time="20260511T175222Z">Neprohledat, ale prohledat pouze &amp;stávající soubory zdrojů</lang>
          </row>
        </item>
