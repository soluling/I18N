          <lang id="fi" rw="0" ex="1" time="20251104T165055Z" fuzzy="99.5">Delphi-lomakkeen esikatselu</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175326Z">Náhled formuláře Delphi</lang>
        </row>
      </node>
