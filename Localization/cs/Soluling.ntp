      <node class="TDelphiFormNode" name="TPROJECTDROPACTIONFRAME" type="TProjectDropActionFrame" resname="TPROJECTDROPACTIONFRAME" created="20200102T035339Z" objectname="ProjectDropActionFrame" parent="TStandardFrame" flags="[ffInherited]">
        <row id="Height">81</row>
        <item name="ActionGroup" type="TRadioGroup">
          <row id="Left">0</row>
          <row id="Top">0</row>
          <row id="Width">505</row>
          <row id="Height">81</row>
          <row id="Caption" si="15431">
            <value> Action that happens after a project file drops to the open workspace </value>
            <lang id="fi" rw="0" ex="1" time="20230319T233946Z" fuzzy="99.5"> Toiminto, joka tapahtuu sen jälkeen, kun projektitiedosto putoaa avoimeen työtilaan </lang>
            <lang id="cs" rw="0" ex="1" time="20260511T175246Z"> Akce, která se provede po přetažení souboru projektu do otevřeného pracovního prostoru </lang>
          </row>
          <row id="Items.Strings[0]" si="15432">
            <value>&amp;Close the current project and open dropped file</value>
            <lang id="fi" rw="0" ex="1" time="20230319T233951Z" fuzzy="99.5">&amp;Sulje nykyinen projekti ja avaa pudotettu tiedosto</lang>
            <lang id="cs" rw="0" ex="1" time="20260511T175246Z">&amp;Zavřít aktuální projekt a otevřít přetažený soubor</lang>
          </row>
          <row id="Items.Strings[1]" si="15433">
            <value>&amp;Import translations from the dropped file into the active language</value>
            <lang id="fi" rw="0" ex="1" time="20230318T152122Z">&amp;Tuo käännökset pudotetusta tiedostosta aktiiviseen kieleen</lang>
            <lang id="cs" rw="0" ex="1" time="20260511T175246Z">&amp;Importovat překlady z přetaženého souboru do aktivního jazyka</lang>
          </row>
          <row id="Items.Strings[2]" si="15434">
            <value>I&amp;mport translations from the dropped file into all languages</value>
            <lang id="fi" rw="0" ex="1" time="20230318T152132Z">&amp;Tuon käännökset pudotusta tiedostosta kaikille kielille</lang>
            <lang id="cs" rw="0" ex="1" time="20260511T175246Z">I&amp;mportovat překlady z přetaženého souboru do všech jazyků</lang>
          </row>
        </item>
