          <lang id="fi" rw="0" ex="1" time="20251111T154727Z" fuzzy="99.5">Tuodaan "%s" käännösmuistiin "%s"</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175500Z">Import „%s“ do překladové paměti „%s“</lang>
        </row>
        <row id="SStringLength" changed="20250106T095608Z" si="17780" created="20250106T095608Z" codep="1">
          <value>String length is %d characters.</value>
          <lang id="fi" rw="0" ex="1" time="20251111T154728Z" fuzzy="99.5">Merkkijonon pituus on %d merkkiä.</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175500Z">Délka řetězce je %d znaků.</lang>
        </row>
        <row id="SUseSegmentation" si="17781">
          <value>Use segmentation.</value>
          <lang id="fi" rw="0" ex="1" time="20251111T154729Z" fuzzy="99.5">Käytä segmentointia.</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175500Z">Použijte členění.</lang>
        </row>
        <row id="SNoSegmentation" si="17782">
          <value>No segmentation.</value>
          <lang id="fi" rw="0" ex="1" time="20251111T154730Z" fuzzy="99.5">Ei segmentointia.</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175500Z">Žádné členění.</lang>
        </row>
        <row id="SReduce" si="17783">
          <value>Remove white spaces and special characters.</value>
          <lang id="fi" rw="0" ex="1" time="20251111T154731Z" fuzzy="99.5">Poista välilyönnit ja erikoismerkit.</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175500Z">Odstranit prázdná místa a speciální znaky.</lang>
        </row>
        <row id="SKeep" changed="20221106T160906Z" si="17784">
