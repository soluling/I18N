        <row id="SUpdatingRows" changed="20250106T095608Z" si="19628" created="20250106T095608Z" codep="1">
          <value>Updating %s rows in "%s" table</value>
          <lang id="fi" rw="0" ex="1" time="20251110T161022Z" fuzzy="99.5">Päivitetään %s riviä taulukossa "%s"</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175449Z">Aktualizace řádků %s v tabulce „%s“</lang>
        </row>
        <row id="SWrongOriginalLanguage" changed="20250106T095608Z" si="19629" created="20250106T095608Z" codep="1">
          <value>%0:s table does not contain any %1:s rows. Select a different original language. Possible values are %2:s</value>
          <lang id="fi" rw="0" ex="1" time="20251110T161023Z" fuzzy="99.5">%0:s-taulukko ei sisällä yhtään %1:s riviä. Valitse toinen alkuperäinen kieli. Mahdolliset arvot ovat %2:s</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175450Z">tabulka %0:s neobsahuje žádné řádky %1:s. Vyberte jiný původní jazyk. Možné hodnoty jsou %2:s</lang>
        </row>
        <row id="STableDoesNotContainRow" changed="20250106T095608Z" si="19630" created="20250106T095608Z" codep="1">
          <value>%s table does not contain any rows</value>
          <lang id="fi" rw="0" ex="1" time="20251110T161024Z" fuzzy="99.5">%s-taulukko ei sisällä rivejä</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175450Z">Tabulka %s neobsahuje žádné řádky</lang>
        </row>
        <row id="SRowHasNoId" changed="20250106T095608Z" si="19599" created="20250106T095608Z" codep="1">
          <value>"%0:s" row has no value in "%1:s" field. Row skipped.</value>
          <lang id="fi" rw="0" ex="1" time="20251110T161025Z" fuzzy="99.5">Rivillä "%0:s" ei ole arvoa kentässä "%1:s". Rivi ohitettu.</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175450Z">řádek „%0:s“ nemá žádnou hodnotu v poli „%1:s“. Řádek byl přeskočen.</lang>
        </row>
        <row id="SUpdatingColumns" changed="20250106T095608Z" si="19600" created="20250106T095608Z" codep="1">
          <value>Updating %s columns in "%s" table</value>
          <lang id="fi" rw="0" ex="1" time="20251110T161026Z" fuzzy="99.5">Päivitetään %s saraketta taulukossa "%s"</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175450Z">Aktualizace sloupců %s v tabulce „%s“</lang>
        </row>
        <row id="SColumnNotFound" changed="20250106T095608Z" si="19601" created="20250106T095608Z" codep="1">
          <value>There is no column associated with "%0:s" language for the original "%1:s" column in "%2:s" table. Language skipped</value>
          <lang id="fi" rw="0" ex="1" time="20251110T160745Z" fuzzy="99.5">Alkuperäiselle sarakkeelle "%1:s" taulukossa "%2:s" ei ole kielelle "%0:s" liitettyä saraketta. Kieli ohitettu</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175450Z">Pro původní sloupec „%1:s“ v tabulce „%2:s“ neexistuje žádný sloupec spojený s jazykem „%0:s“. Jazyk přeskočen</lang>
        </row>
        <row id="SCheckEncoding" si="19616">
          <value>Check that original and localized encodings match the encoding used in the database.</value>
          <lang id="fi" rw="0" ex="1" time="20251110T161027Z" fuzzy="99.5">Tarkista, että alkuperäinen ja lokalisoitu koodaus vastaavat tietokannassa käytettyä koodausta.</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175451Z">Zkontrolujte zda původní a lokalizované kódování odpovídá kódování použitému v databázi.</lang>
        </row>
        <row id="SAbortingBuild" si="19617">
          <value>Aborting the build process.</value>
          <lang id="fi" rw="0" ex="1" time="20251110T160846Z" fuzzy="99.5">Rakennusprosessin keskeyttäminen.</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175451Z">Přerušení procesu vytváření.</lang>
