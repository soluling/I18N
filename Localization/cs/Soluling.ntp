              <item name="InstallAllRadio" type="TRadioButton">
                <row id="Left">32</row>
                <row id="Top">40</row>
                <row id="Width">492</row>
                <row id="Height">17</row>
                <row id="Caption" si="28126">
                  <value>Install &amp;all files including all samples and spell check dictionaries</value>
                  <lang id="fi" rw="0" ex="1" time="20251113T164201Z">&amp;Asenna kaikki tiedostot, mukaan lukien kaikki esimerkit ja oikeinkirjoituksen tarkistussanakirjat</lang>
                  <lang id="cs" rw="0" ex="1" time="20260511T183006Z">N&amp;ainstalovat všechny soubory včetně všech ukázek a slovníků kontroly pravopisu</lang>
                </row>
              </item>
              <item name="InstallMinimalRadio" type="TRadioButton">
                <row id="Left">32</row>
                <row id="Top">64</row>
                <row id="Width">492</row>
                <row id="Height">17</row>
                <row id="Caption" si="28127">
                  <value>Install only the &amp;required application files but no samples or spell check dictionaries</value>
                  <lang id="fi" rw="0" ex="1" time="20251109T142845Z" fuzzy="99.5">Asenna vain &amp;vaaditut sovellustiedostot, mutta älä esimerkkejä tai oikeinkirjoituksen tarkistussanakirjoja</lang>
                  <lang id="cs" rw="0" ex="1" time="20260511T185028Z">Nainstalovat pouze soubory &amp;potřebné aplikace, ale bez ukázek a slovníků pro kontrolu pravopisu</lang>
                </row>
              </item>
              <item name="InstallAutomationRadio" type="TRadioButton">
                <row id="Left">32</row>
                <row id="Top">88</row>
                <row id="Width">492</row>
                <row id="Height">17</row>
                <row id="Caption" si="28128">
                  <value>Install only files needed by &amp;build automation</value>
                  <lang id="fi" rw="0" ex="1" time="20251109T142846Z" fuzzy="99.5">Asenna vain tiedostot, joita &amp;build-automaatio tarvitsee</lang>
                  <lang id="cs" rw="0" ex="1" time="20260511T182954Z">Nainstalovat pouze soubory potřebné pro &amp;automatizaci sestavení</lang>
                </row>
              </item>
              <item name="InstallCustomRadio" type="TRadioButton">
                <row id="Left">32</row>
