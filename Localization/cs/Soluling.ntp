        </row>
        <row id="SNoMeaning" changed="20250106T095608Z" si="17293" created="20250106T095608Z" codep="1">
          <value>No meaning value for "%s" (%s)</value>
          <lang id="fi" rw="0" ex="1" time="20251105T153117Z">Ei merkitysarvoa "%s":lle (%s)</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175312Z">Žádná významová hodnota pro „%s“ (%s)</lang>
        </row>
        <row id="SDuplicateMeaning" changed="20250106T095608Z" si="17294" created="20250106T095608Z" codep="1">
          <value>"%s" meaning has been used more than once in "%s". Using id instead.</value>
          <lang id="fi" rw="0" ex="1" time="20251104T124748Z" fuzzy="99.5">Merkitystä "%s" on käytetty useammin kuin kerran kohdassa "%s". Käytetään sen sijaan tunnistetta "id".</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175312Z">význam „%s“ byl použit více než jednou v „%s“. Místo toho se použije id.</lang>
        </row>
        <row id="SDuplicateValue" changed="20250106T095608Z" si="17263" created="20250106T095608Z" codep="1">
          <value>"%s" value has been used more than once in "%s". Using id instead.</value>
          <lang id="fi" rw="0" ex="1" time="20251104T124751Z" fuzzy="99.5">Arvoa "%s" on käytetty useammin kuin kerran kohteessa "%s". Käytetään sen sijaan tunnusta.</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175311Z">hodnota „%s“ byla použita více než jednou v „%s“. Místo toho se použije id.</lang>
        </row>
        <row id="SNotJsonFile" changed="20250106T095608Z" si="22652" created="20250106T095608Z" codep="1">
          <value>"%s" is not a valid Angular JSON resource file</value>
          <lang id="fi" rw="0" ex="1" time="20251104T124754Z" fuzzy="99.5">"%s" ei ole kelvollinen Angular JSON -resurssitiedosto</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175311Z">„%s“ není platný soubor zdrojů JSON jazyka Angular</lang>
