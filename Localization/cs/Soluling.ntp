          <row id="Top">0</row>
          <row id="Width">505</row>
          <row id="Height">97</row>
          <row id="Caption" si="1707">
            <value> Import translations from the original file </value>
            <lang id="fi" rw="0" ex="1" time="20230320T135511Z" fuzzy="99.5"> Tuo käännökset alkuperäisestä tiedostosta </lang>
            <lang id="cs" rw="0" ex="1" time="20260511T175251Z"> Importovat překlady z původního souboru </lang>
          </row>
          <row id="Items.Strings[0]" si="1708">
            <value>&amp;Never</value>
            <lang id="fi" rw="0" ex="1" time="20230319T173418Z">&amp;Ei koskaan</lang>
            <lang id="cs" rw="0" ex="1" time="20260511T175251Z">&amp;Nikdy</lang>
          </row>
          <row id="Items.Strings[1]" si="15526" created="20200102T035339Z">
            <value>Import a translation if there is no current value and the translation is not the same as &amp;original</value>
            <lang id="fi" rw="0" ex="1" time="20230319T174219Z">Tuo käännös, jos nykyistä arvoa ei ole ja käännös ei ole sama kuin &amp;alkuperäinen</lang>
            <lang id="cs" rw="0" ex="1" time="20260511T175251Z">Imp&amp;ortovat překlad, pokud není k dispozici aktuální hodnota a překlad se liší od originálu</lang>
          </row>
          <row id="Items.Strings[2]" si="1710">
            <value>Import a translation if there is no current &amp;value</value>
            <lang id="fi" rw="0" ex="1" time="20230319T174231Z">Tuo käännös, jos nykyistä &amp;arvoa ei ole</lang>
            <lang id="cs" rw="0" ex="1" time="20260511T175251Z">Importovat překlad, pokud neexistuje aktuální &amp;hodnota</lang>
          </row>
          <row id="Items.Strings[3]" si="15527" created="20200102T035339Z">
            <value>&amp;Import translation and overwrite the possible existing value in the project</value>
            <lang id="fi" rw="0" ex="1" time="20230320T140058Z" fuzzy="99.5">&amp;Tuo käännös ja korvaa projektin mahdollinen olemassa oleva arvo</lang>
            <lang id="cs" rw="0" ex="1" time="20260511T175251Z">&amp;Importovat překlad a přepsat případnou existující hodnotu v projektu</lang>
          </row>
        </item>
