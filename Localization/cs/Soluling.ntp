          <item name="UnusedStringsCheck" type="TCheckBox">
            <row id="Left">8</row>
            <row id="Top">56</row>
            <row id="Width">425</row>
            <row id="Height">17</row>
            <row id="Caption" si="2294">
              <value>Add &amp;unused strings to the translation memory</value>
              <lang id="fi" rw="0" ex="1" time="20230404T231946Z" fuzzy="99.5">Lisää &amp;käyttämättömät merkkijonot käännösmuistiin</lang>
              <lang id="cs" rw="0" ex="1" time="20260511T175302Z">Přidat &amp;nepoužité řetězce do překladové paměti</lang>
            </row>
          </item>
          <item name="EveryTimeCheck" type="TCheckBox">
            <row id="Left">8</row>
            <row id="Top">75</row>
            <row id="Width">425</row>
            <row id="Height">17</row>
            <row id="Caption" si="2295">
              <value>Add a string even if it has &amp;already been added to a translation memory</value>
              <lang id="fi" rw="0" ex="1" time="20230404T232354Z" fuzzy="99.5">Lisää merkkijono, vaikka se olisi &amp;jo lisätty käännösmuistiin</lang>
              <lang id="cs" rw="0" ex="1" time="20260511T175302Z">Přid&amp;at řetězec, i když již byl přidán do překladové paměti</lang>
            </row>
          </item>
          <item name="SameAsOriginalCheck" type="TCheckBox">
            <row id="Left">8</row>
            <row id="Top">94</row>
            <row id="Width">425</row>
            <row id="Height">17</row>
            <row id="Caption" si="2296">
              <value>Add even i&amp;f the translation equals the original value</value>
              <lang id="fi" rw="0" ex="1" time="20230404T232402Z" fuzzy="99.5">&amp;Lisää vaikka käännös vastaa alkuperäistä arvoa</lang>
              <lang id="cs" rw="0" ex="1" time="20260511T175302Z">&amp;Přidat i v případě, že překlad odpovídá původní hodnotě</lang>
            </row>
          </item>
          <item name="RemoveOldCheck" type="TCheckBox">
            <row id="Left">8</row>
            <row id="Top">113</row>
            <row id="Width">425</row>
            <row id="Height">17</row>
            <row id="Caption" si="2297">
              <value>&amp;Remove the old translation if the translation in the project changes</value>
              <lang id="fi" rw="0" ex="1" time="20230404T232400Z" fuzzy="99.5">&amp;Poista vanha käännös, jos projektin käännös muuttuu</lang>
              <lang id="cs" rw="0" ex="1" time="20260511T175302Z">&amp;Odstranit starý překlad, pokud se překlad v projektu změní</lang>
            </row>
          </item>
        </item>
