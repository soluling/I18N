      <node class="TWindowsStringNode" name="AutoTranslatorFra" created="20200102T060958Z">
        <row id="SEstimateSingle" changed="20250106T095608Z" si="15912" created="20250106T095608Z" codep="1">
          <value>Translation cost is %0:d cents per word. The total cost of %1:d words is up to %2:m, depending on how many matches are found.</value>
          <lang id="fi" rw="0" ex="1" time="20251104T125743Z" fuzzy="99.5">Käännöskustannukset ovat %0:d senttiä sanalta. Kokonaiskustannukset %1:d sanalle ovat jopa %2:m riippuen löydettyjen osumien määrästä.</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175313Z">Cena překladu je %0:d centů za slovo. Celková cena za %1:d slov je až %2:m, v závislosti na tom, kolik shod se najde.</lang>
        </row>
        <row id="SEstimateRange" changed="20250106T095608Z" si="15913" created="20250106T095608Z" codep="1">
          <value>Translation cost is from %0:d to %1:d sents per word. Total cost of %2:d words is from %3:m to %4:m.</value>
          <lang id="fi" rw="0" ex="1" time="20251104T125745Z" fuzzy="99.5">Käännöskustannukset ovat %0:d–%1:d senttiä sanaa kohden. Kokonaiskustannukset %2:d sanalle ovat %3:m–%4:m.</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T175313Z">Náklady na překlad jsou od %0:d do %1:d centů za slovo. Celková cena za %2:d slov je od %3:m do %4:m.</lang>
        </row>
      </node>
      <node class="TWindowsStringNode" name="BackTranslateDlg" created="20210110T150954Z">
