                  <lang id="fi" rw="0" ex="1" time="20251109T142848Z" fuzzy="99.5">&amp;Minä valitsen asennettavat</lang>
                  <lang id="cs" rw="0" ex="1" time="20260511T192245Z">&amp;Vybrat co se má nainstalovat</lang>
                </row>
