          <lang id="fi" rw="0" ex="1" time="20251109T153210Z" fuzzy="99.5">Asennetaan sovelluskirjastotiedostoja...</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T182904Z">Instalace souborů knihovny aplikací...</lang>
        </row>
        <row id="SInstallingBuildAutomationFiles" si="26285">
