                <lang id="fi" rw="0" ex="1" time="20251109T141410Z" fuzzy="99.5"> Valitse asennustyyppi </lang>
                <lang id="cs" rw="0" ex="1" time="20260511T184913Z"> Vybrat typ instalace </lang>
              </row>
              <row id="Items.Strings[0]" si="28119">
                <value>Enter a license key to install a registered edition</value>
                <lang id="fi" rw="0" ex="1" time="20251109T141413Z" fuzzy="99.5">Syötä lisenssiavain asentaaksesi rekisteröidyn version</lang>
                <lang id="cs" rw="0" ex="1" time="20260511T184849Z">Zadat licenční klíč pro instalaci registrované edice</lang>
              </row>
              <row id="Items.Strings[1]" si="28120">
                <value>Start an evaluation period</value>
                <lang id="fi" rw="0" ex="1" time="20251109T141426Z" fuzzy="99.5">Aloita kokeilujakso</lang>
                <lang id="cs" rw="0" ex="1" time="20260511T192032Z">Zahájit zkušební období</lang>
              </row>
              <row id="Items.Strings[2]" si="28121">
                <value>Install the free Basic Translator edition</value>
                <lang id="fi" rw="0" ex="1" time="20251109T142836Z" fuzzy="99.5">Asenna ilmainen Basic Translator -versio</lang>
                <lang id="cs" rw="0" ex="1" time="20260511T184858Z">Nainstalovat bezplatnou edici Basic Translator</lang>
              </row>
            </item>
