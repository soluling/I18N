      <node class="TDelphiFormNode" name="TEXITSETUPDIALOG" type="TExitSetupDialog" resname="TEXITSETUPDIALOG" objectname="ExitSetupDialog" parent="TSetupDialog" flags="[ffInherited]">
        <row id="Left">237</row>
        <row id="Top">491</row>
        <row id="Caption" si="28063">
          <value>Exit Setup</value>
          <lang id="fi" rw="0" ex="1" time="20251109T140802Z" fuzzy="99.5">Poistu asetuksista</lang>
          <lang id="cs" rw="0" ex="1" time="20260511T182954Z">Ukončit instalaci</lang>
        </row>
        <row id="ClientHeight">103</row>
        <row id="ClientWidth">374</row>
        <item name="Label1" type="TLabel" autosize="0">
          <row id="Left">8</row>
          <row id="Top">8</row>
          <row id="Width">361</row>
          <row id="Height">33</row>
          <row id="Caption" si="28064">
            <value>Setup is not complete. If you quit the Setup program now, Soluling will not be installed.</value>
            <lang id="fi" rw="0" ex="1" time="20251109T140807Z" fuzzy="99.5">Asennus ei ole valmis. Jos suljet asennusohjelman nyt, Solulingia ei asenneta.</lang>
            <lang id="cs" rw="0" ex="1" time="20260511T182954Z">Instalace není dokončena. Pokud nyní ukončíte instalační program, Soluling nebude nainstalován.</lang>
          </row>
        </item>
        <item name="Label2" type="TLabel" autosize="0">
          <row id="Left">8</row>
          <row id="Top">40</row>
          <row id="Width">361</row>
          <row id="Height">33</row>
          <row id="Caption" si="28065">
            <value>To continue installing the program, click Resume. To quit the Setup program, click Exit Setup.</value>
            <lang id="fi" rw="0" ex="1" time="20251109T140809Z" fuzzy="99.5">Jatkaaksesi ohjelman asennusta, napsauta Jatka. Sulje asennusohjelma napsauttamalla Poistu asennuksesta.</lang>
            <lang id="cs" rw="0" ex="1" time="20260511T192719Z">Pro pokračování v instalaci programu, klikněte na Pokračovat. Pro ukončení instalace programu, klikněte na Ukončit instalaci.</lang>
          </row>
        </item>
        <item name="ResumeButton" type="TButton">
          <row id="Left">64</row>
          <row id="Top">72</row>
          <row id="Width">121</row>
          <row id="Height">25</row>
