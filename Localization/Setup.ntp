                <row id="Height">17</row>
                <row id="Caption" si="28126">
                  <value>Install &amp;all files including all samples and spell check dictionaries</value>
                  <lang id="fi" rw="0" ex="1" time="20251113T164201Z">&amp;Asenna kaikki tiedostot, mukaan lukien kaikki esimerkit ja oikeinkirjoituksen tarkistussanakirjat</lang>
                  <lang id="cs" rw="0" ex="1" time="20260511T183006Z">N&amp;ainstalovat všechny soubory včetně všech ukázek a slovníků kontroly pravopisu</lang>
