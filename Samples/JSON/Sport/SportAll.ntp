    <item class="TJsonComponent" name="hockey">
      <row id="name" si="4">Ice hockey</row>
      <row id="origin" si="5">Canada</row>
      <row id="description" si="6">Ice hockey is a team sport played on ice, in which skaters use sticks to direct a puck into the opposing team's goal.</row>
    </item>
    <item class="TJsonComponent" name="basketball">
      <row id="name" si="7">Basketball</row>
      <row id="origin" si="8">United States</row>
      <row id="description" si="9">Basketball is a team sport in which two teams of five players try to score points by throwing a ball through the top of a basketball hoop while following a set of rules.</row>
    </item>
