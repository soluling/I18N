        <row id="_.This has no id" si="60">
          <value>This has no id</value>
          <lang id="fi" rw="0" time="20261010T065822Z" fuzzy="99.5">Tällä ei ole tunnusta</lang>
          <lang id="fr" st="1" or="6" rw="0" time="20261012T082135Z" fuzzy="99.5">Ceci n'a pas d'identifiant</lang>
