        <row id="_.hello" si="61">
          <value>This has an id</value>
          <lang id="fi" rw="0" time="20261010T065836Z" fuzzy="99.5">Tällä on tunnus</lang>
          <lang id="fr" st="1" or="6" rw="0" time="20261012T082138Z" fuzzy="99.5">Celui-ci possède un identifiant</lang>
          <lang id="de" st="2" or="3" rw="0" time="20261007T160059Z">Dies ist ein Beispiel.</lang>
          <lang id="ja" rw="0" time="20261010T071125Z" fuzzy="99.5">これにはIDがあります</lang>
        </row>
        <row id="group.hello" si="62">
          <value>This has a group and an id</value>
          <lang id="fi" rw="0" time="20261010T065842Z" fuzzy="99.5">Tässä on ryhmä ja tunnus</lang>
          <lang id="fr" st="1" or="6" rw="0" time="20261012T082147Z" fuzzy="99.5">Celui-ci comporte un groupe et un identifiant</lang>
          <lang id="de" st="2" or="3" rw="0" time="20261007T160059Z">Dies ist ein Beispiel.</lang>
          <lang id="ja" rw="0" time="20261010T071220Z" fuzzy="99.5">これにはグループとIDがあります</lang>
        </row>
        <row id="group.This has an group but no id" si="63">
          <value>This has an group but no id</value>
          <lang id="fi" rw="0" time="20261010T065811Z" fuzzy="99.5">Tällä on ryhmä, mutta ei tunnusta</lang>
          <lang id="fr" st="1" or="6" rw="0" time="20261012T082150Z" fuzzy="99.5">Cet élément appartient à un groupe, mais n'a pas d'identifiant.</lang>
          <lang id="ja" rw="0" time="20261010T071222Z" fuzzy="99.5">これにはグループがありますが、IDがありません</lang>
