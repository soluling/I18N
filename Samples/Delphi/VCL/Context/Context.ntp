          <pattern plural="pfOne">%d open ticket</pattern>
        </row>
        <row id="SSummary" si="8" scannedcomment="0: Number of support tickets, 1: Number of queues where the tickets are waiting" codep="1">
          <value startpattern="1">%0:s in %1:s</value>
          <pattern plural="pfOne" index="0">%d ticket</pattern>
          <pattern plural="pfOther" index="0">%d tickets</pattern>
          <pattern plural="pfOne" index="1">%d queue</pattern>
          <pattern plural="pfOther" index="1">%d queues</pattern>
        </row>
        <row id="SPostCount" si="9" scannedcomment="%d: Number of replies published in the support ticket. Post is a noun: a reply." codep="1">
          <value>%d posts</value>
          <pattern plural="pfZero">No posts yet</pattern>
          <pattern plural="pfOne">%d post</pattern>
        </row>
        <row id="SStatusText" si="10" scannedcomment="The status of a support ticket as a sentence. Open and closed are adjectives." codep="1">
          <value select="open">The ticket is open.</value>
          <pattern select="closed">The ticket is closed.</pattern>
          <pattern select="pending">The ticket is waiting for the customer.</pattern>
        </row>
        <row id="SAssigned" si="11" scannedcomment="0: First name of the support agent" codep="1">
          <value gender="geMale">%s assigned the ticket to himself.</value>
          <pattern gender="geFemale">%s assigned the ticket to herself.</pattern>
        </row>
        <row id="SStatusOpen" si="18" scannedcomment="Status of a support ticket (adjective): the problem is not solved yet. Not a command.">Open</row>
        <row id="SStatusPending" si="19" scannedcomment="Status of a support ticket (adjective): waiting for an answer from the customer.">Pending</row>
        <row id="SStatusClosed" si="20" scannedcomment="Status of a support ticket (adjective): the problem has been solved.">Closed</row>
        <row id="SOpenCommand" si="21" scannedcomment="Button (verb): opens a closed support ticket again. &amp; marks the hotkey." scannedmaxcharacters="12">&amp;Open</row>
        <row id="SCloseCommand" si="22" scannedcomment="Button (verb): marks the support ticket solved. &amp; marks the hotkey." scannedmaxcharacters="12">&amp;Close</row>
        <row id="SNear" si="23" scannedcomment="Distance of the store (adjective): near, a short walk away. Not the Close command.">Close</row>
        <row id="SFreePrice" si="24" scannedcomment="Price of a product (adjective): it costs nothing. Not &quot;available&quot; or &quot;unused&quot;.">Free</row>
        <row id="SFreeSpace" si="25" scannedcomment="0: Amount of disk space, for example &quot;12 GB&quot;. Free means unused here, not &quot;costs nothing&quot;." codep="1">%s free</row>
        <row id="SPosted" si="26" scannedcomment="Message after publishing. Post is a noun here: a reply in a discussion.">Your post was published.</row>
        <row id="SBooked" si="27" scannedcomment="0: Time of the reservation, for example &quot;18:30&quot;. Booked = reserved." codep="1">Table booked for %s.</row>
      </node>
